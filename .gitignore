raw-photos-save/
img/

# ── Sensitive / spoiler-y data ────────────────────────────────────────────────
# photos.csv maps random photo IDs → real trail miles (answers cheat sheet)
misc/photos.csv

# supabase_config.py holds the publishable anon key — safe to expose but
# conventional to gitignore. Copy misc/supabase_config.template.py to get started.
misc/supabase_config.py

# ── Local-only tools ──────────────────────────────────────────────────────────
app-explore/

# ── Generated HTML build artifacts ───────────────────────────────────────────
