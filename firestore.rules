rules_version = '2';

// PCT GeoGuesser — Firestore access rules (replaces the Supabase RLS policies).
// Deploy: npx firebase-tools deploy --only firestore:rules
//
// Everything is publicly readable (leaderboard, hiker pages, stats).
//
// Saving a scored game is one batched write from the game page:
//   profiles/{uid}          game_count + 1, last_game_at = now, last_session_id
//                           (+ best_* when the game beats the player's best)
//   game_sessions/{sid}     the game (played_at = now)
//   game_guesses/{sid}_{i}  one per photo (i = 0..9)
// The profile update carries the rate limit (1 per minute) and the 15-game cap;
// the session and guesses are only accepted inside that same write.

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin is identified by uid (not email, which would then be public in
    // page source). Keep in sync with ADMIN_UID in misc/firebase_config.py.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == '1791279a-bd07-4345-9448-e06ce5807d97';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    // ── profiles ──────────────────────────────────────────────────────────
    // best_score / best_perfects / best_session_id copy the player's best game
    // so the leaderboard is one query (profiles ordered by best_score).
    function validProfile(d) {
      return d.keys().hasOnly(['trail_name', 'pct_year', 'about', 'created_at',
                               'game_count', 'last_game_at', 'last_session_id',
                               'best_score', 'best_perfects', 'best_session_id'])
        && d.trail_name is string && d.trail_name.size() > 0 && d.trail_name.size() <= 60
        && d.pct_year   is string && d.pct_year.size()   > 0 && d.pct_year.size()   <= 40
        && (d.get('about', null) == null
            || (d.about is string && d.about.size() <= 1000))
        && (d.get('best_score', null) == null
            || (d.best_score is number && d.best_score >= 0 && d.best_score <= 2680))
        && (d.get('best_perfects', null) == null
            || (d.best_perfects is int && d.best_perfects >= 0 && d.best_perfects <= 20))
        && (d.get('best_session_id', null) == null || d.best_session_id is string);
    }

    function unchanged(field, fallback) {
      return request.resource.data.get(field, fallback) == resource.data.get(field, fallback);
    }

    function bestUnchanged() {
      return unchanged('best_score', null) && unchanged('best_perfects', null)
        && unchanged('best_session_id', null);
    }

    function isProfileEdit() {
      return unchanged('game_count', 0) && unchanged('last_game_at', null)
        && unchanged('last_session_id', null) && bestUnchanged();
    }

    // The game saved in this same write must be the player's own new one; if
    // it beats their best, the best_* fields must copy it, otherwise stay put.
    function bestTracksGame(d) {
      let s    = getAfter(/databases/$(database)/documents/game_sessions/$(d.last_session_id)).data;
      let beat = s.total_score > resource.data.get('best_score', -1);
      return s.user_id == request.auth.uid && s.played_at == request.time
        && (beat
            ? (d.get('best_score', null) == s.total_score
               && d.get('best_perfects', null) == s.perfect_count
               && d.get('best_session_id', null) == d.last_session_id)
            : bestUnchanged());
    }

    function isGameSubmission() {
      let d    = request.resource.data;
      let prev = resource.data.get('last_game_at', null);
      return unchanged('trail_name', null) && unchanged('pct_year', null) && unchanged('about', null)
        && resource.data.get('game_count', 0) < 15
        && d.game_count == resource.data.get('game_count', 0) + 1
        && d.last_game_at == request.time
        && (prev == null || request.time > prev + duration.value(60, 's'))
        && d.last_session_id is string
        && bestTracksGame(d);
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.created_at == request.time
        && request.resource.data.keys().hasOnly(['trail_name', 'pct_year', 'about', 'created_at']);
      allow update: if validProfile(request.resource.data)
        && unchanged('created_at', null)
        && ((isOwner(uid) && (isProfileEdit() || isGameSubmission())) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── game_sessions ─────────────────────────────────────────────────────
    function validSession(d) {
      return d.keys().hasOnly(['user_id', 'total_score', 'perfect_count', 'photo_count', 'played_at'])
        && d.total_score is number && d.total_score >= 0 && d.total_score <= 2680
        && d.photo_count is int && d.photo_count >= 1 && d.photo_count <= 20
        && d.perfect_count is int && d.perfect_count >= 0 && d.perfect_count <= d.photo_count;
    }

    match /game_sessions/{sid} {
      allow read: if true;
      // sid must be a Firestore auto-ID (it is embedded in guess-id patterns)
      allow create: if request.auth != null
        && sid.matches('[A-Za-z0-9]{20}')
        && validSession(request.resource.data)
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.played_at == request.time
        && getAfter(profilePath(request.auth.uid)).data.last_session_id == sid
        && getAfter(profilePath(request.auth.uid)).data.last_game_at == request.time;
      allow delete: if isAdmin();
    }

    // ── game_guesses ──────────────────────────────────────────────────────
    function validGuess(d) {
      return d.keys().hasOnly(['session_id', 'photo_id', 'true_mile', 'guessed_mile', 'score', 'timed_out'])
        && d.session_id is string && d.session_id.matches('[A-Za-z0-9]{20}')
        && d.photo_id is string && d.photo_id.size() <= 16
        && d.true_mile is number
        && (d.guessed_mile == null || d.guessed_mile is number)
        && d.score is number && d.score >= 0 && d.score <= 266
        && d.timed_out is bool;
    }

    match /game_guesses/{gid} {
      allow read: if true;
      allow create: if request.auth != null
        && validGuess(request.resource.data)
        && gid.matches(request.resource.data.session_id + '_[0-9]')
        && getAfter(/databases/$(database)/documents/game_sessions/$(request.resource.data.session_id)).data.user_id == request.auth.uid
        && getAfter(/databases/$(database)/documents/game_sessions/$(request.resource.data.session_id)).data.played_at == request.time;
      allow delete: if isAdmin();
    }

    // Legacy per-photo aggregates imported from Supabase. Admin stats are now
    // computed from game_guesses; nothing writes here.
    match /photo_stats/{photoId} {
      allow read: if true;
    }

    match /site_settings/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
